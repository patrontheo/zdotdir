#!/bin/zsh

# Forward the same local and remote ports (e.g. sshf obiwan 5177 5003).
if (( $# < 2 )) || [[ -z $1 || $1 == -* ]]; then
    print -u2 -- 'Usage: sshf HOST PORT [PORT ...]'
    return 1
fi

if (( ! $+commands[autossh] )); then
    print -u2 -- '[sshf] autossh is not installed'
    return 127
fi

local host=$1 port
local -a cmd=(autossh -M 0 -N -o ConnectTimeout=5 -o ExitOnForwardFailure=yes)
shift

for port in "$@"; do
    if [[ $port != <1-65535> ]]; then
        print -u2 -- "[sshf] Invalid port: $port (expected 1-65535)"
        return 1
    fi
    cmd+=(-L "${port}:localhost:${port}")
done

cmd+=("$host")
print -r -- "[sshf] Executing: ${(q)cmd}"
"${cmd[@]}"
